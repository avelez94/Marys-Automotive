# Public site
SITE_URL=                      # e.g. https://marysautomotive.com once the domain is reconnected. Drives canonicals, sitemap, OG.
ALLOW_INDEXING=                # leave empty: production indexes, previews never do. Set "false" to block production too.
SHOW_PENDING_MARKERS=          # leave empty: shown on previews, hidden in production.

# Supabase (quote requests, admin auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # server only. Never prefix with NEXT_PUBLIC_.

# Email (existing Resend setup)
RESEND_API_KEY=
FROM_EMAIL=
SHOP_EMAIL=                    # receives invoice CC and new quote notifications
INVOICE_STORAGE=               # second invoice CC for archiving
QUOTE_NOTIFY_EMAIL=            # optional override for quote notifications

# Optional
RATE_LIMIT_SALT=               # random string used to hash IP addresses for rate limiting
