{
  "functions": {
    "api/send-invoice.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/send-invoice",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://marysautomotive.com",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "continue": false,
      "status": 204
    },
    {
      "src": "/api/send-invoice",
      "dest": "/api/send-invoice"
    }
  ]
}
